# Developer OS - Environment Variables
# Copy this file to .env.local and fill in your values

# Database Configuration
1 -> Go to {https://supabase.com/}
2 -> click [Strart your project]
3 -> click [+New project]
DATABASE_URL="[GENERATE_ME_WITH_STEPS_ABOVE]"

# Authentication
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="[GENERATE_ME_WITH_COMMAND_ABOVE]"

# OAuth Providers (optional)
# GitHub: https://github.com/settings/applications/new
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"