# Developer OS - Environment Variables
# Copy this file to .env.local and fill in your values

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/developer_os"

# Authentication
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="[GENERATE_ME_WITH_COMMAND_ABOVE]"

# OAuth Providers (optional)
# GitHub: https://github.com/settings/applications/new
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
